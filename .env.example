# --- Database -----------------------------------------------------------
# PostgreSQL connection string (docker-compose provides one out of the box)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mmr_oracle?schema=public"

# --- Data sources --------------------------------------------------------
# Optional: OpenDota API key for higher rate limits (https://www.opendota.com/api-keys)
# Without a key the free tier (~60 req/min) is used, which is fine for local use.
OPENDOTA_API_KEY=""

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey).
# Only needed to resolve vanity URLs like https://steamcommunity.com/id/username.
# Numeric profile links, Dotabuff and OpenDota links work without it.
STEAM_API_KEY=""

# --- App -----------------------------------------------------------------
# Public base URL of the deployment (used for share links and SEO metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
